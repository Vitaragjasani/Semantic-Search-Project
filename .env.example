# Chunking configuration
CHUNK_SIZE=800
CHUNK_OVERLAP=150

# Upload limits
MAX_UPLOAD_SIZE_MB=50

# OpenRouter (do not commit your real key)
# Get a key at https://openrouter.ai/keys
# OPENROUTER_API_KEY=

# Before relying on the default model below, check
# https://openrouter.ai/models?max_price=0 for the current free-model list --
# ":free" model slugs change as providers add/remove prerelease checkpoints.
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free
OPENROUTER_TEMPERATURE=0.1
OPENROUTER_MAX_TOKENS=512
OPENROUTER_TIMEOUT_SECONDS=30

# Retrieval / context budget
RAG_TOP_K=5
SEMANTIC_CANDIDATES=20
KEYWORD_CANDIDATES=20
MAX_CONTEXT_CHARS=6000
